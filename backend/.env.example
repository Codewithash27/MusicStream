# Application
APP_NAME=MusicStream
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (Supabase Postgres)
# NOTE: @ in password must be URL-encoded as %40
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Supabase Storage (required — sole file storage backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET_SONGS=songs
SUPABASE_STORAGE_BUCKET_COVERS=covers
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

# Upload limits (bytes) — 25MB audio, 5MB cover/avatar
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_COVER_UPLOAD_BYTES=5242880
MAX_AVATAR_UPLOAD_BYTES=5242880
