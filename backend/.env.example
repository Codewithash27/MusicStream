# Application
APP_NAME=MusicStream
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
# NOTE: @ in password must be URL-encoded as %40
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Object storage (Cloudflare R2 / S3). Use STORAGE_BACKEND=local for local uploads/
STORAGE_BACKEND=local
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=musicstream
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://cdn.example.com
LOCAL_UPLOAD_DIR=uploads

# Upload limits (bytes) — 20MB audio, 5MB cover
MAX_AUDIO_UPLOAD_BYTES=20971520
MAX_COVER_UPLOAD_BYTES=5242880
